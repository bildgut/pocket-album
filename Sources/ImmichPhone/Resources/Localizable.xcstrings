            "value": "Ansehen, Favorit & Löschen"
          }
        }
      }
    },
    "Waiting for Wi-Fi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet auf WLAN."
          }
        }
