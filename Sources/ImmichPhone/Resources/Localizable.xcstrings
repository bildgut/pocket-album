    "Your API key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein API-Key"
          }
        }
      }
    },
    "Your API key doesn’t allow this, so the button is now hidden. You can add the permission to the key in Immich.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein API-Key erlaubt das nicht, deshalb ist der Knopf jetzt ausgeblendet. Das Recht kannst du dem Key in Immich hinzufügen."
          }
        }
      }
    },
    "Your favorite albums, always with you — even offline.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Lieblingsalben immer dabei — auch ohne Verbindung."
